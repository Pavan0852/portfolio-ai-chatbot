
# Application
APP_NAME=Portfolio AI Chatbot API
APP_ENV=production
LOG_LEVEL=INFO

# CORS - Replace with your actual portfolio domain
CORS_ORIGINS=["https://pavan-ai-portfolio-indol.vercel.app/"]

# Qdrant Cloud
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=portfolio_knowledge_gemini

# Gemini Chat Generation
LLM_PROVIDER=google
LLM_API_KEY=
LLM_MODEL=gemini-3.5-flash-lite
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_TIMEOUT=90

# Gemini Embeddings
EMBEDDING_PROVIDER=google
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSIONS=768

# Retrieval
RETRIEVAL_MIN_SCORE=0.60
